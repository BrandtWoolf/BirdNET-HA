# Copy this file to `.env` and adjust as needed.

# BirdNET-Go image tag to run (a stable release date tag, or "nightly").
# See https://github.com/tphakala/birdnet-go/releases for available versions.
BIRDNET_VERSION=20260823

# Host port to expose the BirdNET-Go web UI on (container listens on 8080).
WEB_PORT=8080

# Timezone inside the container (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TZ=America/New_York

# User/group IDs the container process runs as, for correct file ownership on
# the mounted ./config and ./data volumes. On macOS the default 1000 is fine.
BIRDNET_UID=1000
BIRDNET_GID=1000
